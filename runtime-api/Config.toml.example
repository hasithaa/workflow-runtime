# Copy to Config.toml. Matches deploy/temporal-dev (Temporal gRPC 7300, HTTP API 7310, namespace finance).
namespace = "finance"
temporalHttpUrl = "http://localhost:7310"
managementUrl = "http://localhost:8240/workflow"
adminApiKey = "<choose one>"
# Key a trusted gateway (ICP in the workflow profile) sends to POST /runtime/integrations/{name}/commands on :9490.
commandApiKey = "<choose one>"

[[registrationKeys]]
keyId = "finance-1"
keyMaterial = "<at least 32 bytes>"
namespace = "finance"

# The embedded workflow module: no workflows, so no worker; serves reads and lifecycle operations.
[ballerina.workflow]
mode = "SELF_HOSTED"
url = "localhost:7300"
namespace = "finance"
taskQueue = "WORKFLOW_RUNTIME_QUEUE"

[ballerina.workflow.management.rest]
enableManagementApi = true
port = 8240
enableBasicAuth = false
trustForwardedIdentity = true
